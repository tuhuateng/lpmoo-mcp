{
  "name": "@lpmoo/mcp",
  "version": "0.1.0",
  "description": "Public stdio MCP server for lpmoo Section JSON tools. Offline stub. Not the lpmoo SaaS.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "bin": {
    "lpmoo-mcp": "./bin/lpmoo-mcp.mjs"
  },
  "exports": {
